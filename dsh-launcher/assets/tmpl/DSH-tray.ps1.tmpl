}
function Sync-LauncherScript {
    # 一键启动脚本与服务器（Z: 技能库）双向同步：逐文件内容哈希比对（不信任缓存/版本号），方向按实际 _meta 时间戳判定
    $notify.ShowBalloonTip(2000, 'DSH 升级', '正在同步启动脚本…', 'Info')
    if (-not (Test-Path -LiteralPath $skillDir)) { throw "本机技能目录不存在：$skillDir" }
    if (-not (Test-Path -LiteralPath 'Z:\')) { throw '服务器（Z: 网络盘）未连接，无法同步' }
    $tmpZip = Join-Path $env:TEMP ("dsh-sync-" + [guid]::NewGuid().ToString('N') + '.zip')
    $stage = Join-Path $env:TEMP ("dsh-sync-" + [guid]::NewGuid().ToString('N'))
    # 加载 ZipFile 程序集（托盘默认不加载，必须在函数内自加载）
    try { Add-Type -AssemblyName System.IO.Compression.FileSystem -ErrorAction Stop } catch {}
    try {
        # 1) 本机技能目录内容清单（相对路径 → SHA256）
        $localMap = @{}
        Get-ChildItem -LiteralPath $skillDir -Recurse -File | ForEach-Object {
            $rel = $_.FullName.Substring($skillDir.Length + 1) -replace '\\','/'
            $localMap[$rel] = (Get-FileHash -LiteralPath $_.FullName -Algorithm SHA256).Hash
        }
        # 2) 服务器包：不存在 → 直接上传；存在 → 新鲜复制到本地再读（避免网络缓存）
        if (-not (Test-Path -LiteralPath $skillHubZip)) {
            & 'C:\Windows\System32\tar.exe' -a -cf $tmpZip -C (Split-Path $skillDir -Parent) 'dsh-launcher'
            if ($LASTEXITCODE -ne 0) { throw "打包失败（exit $LASTEXITCODE）" }
            Copy-Item -LiteralPath $tmpZip -Destination $skillHubZip -Force
            $z = [System.IO.Compression.ZipFile]::OpenRead($skillHubZip); $z.Dispose()
            $notify.ShowBalloonTip(3000, 'DSH 升级', '服务器上还没有启动脚本包，已上传本机版本。', 'Info')
            return
        }
        Copy-Item -LiteralPath $skillHubZip -Destination $tmpZip -Force
        try { $z = [System.IO.Compression.ZipFile]::OpenRead($tmpZip); $z.Dispose() } catch { throw "服务器上的压缩包损坏：$($_.Exception.Message)" }
        New-Item -ItemType Directory -Path $stage -Force | Out-Null
        & 'C:\Windows\System32\tar.exe' -xf $tmpZip -C $stage
        if ($LASTEXITCODE -ne 0) { throw "解包失败（exit $LASTEXITCODE）" }
        $remoteBase = Join-Path $stage 'dsh-launcher'
        if (-not (Test-Path -LiteralPath $remoteBase)) { throw '服务器压缩包缺少 dsh-launcher 目录' }
        $remoteMap = @{}
        Get-ChildItem -LiteralPath $remoteBase -Recurse -File | ForEach-Object {
            $rel = $_.FullName.Substring($remoteBase.Length + 1) -replace '\\','/'
            $remoteMap[$rel] = (Get-FileHash -LiteralPath $_.FullName -Algorithm SHA256).Hash
        }
        # 3) 内容级比对
        $diff = @()
        foreach ($k in @(($localMap.Keys + $remoteMap.Keys) | Select-Object -Unique)) {
            if ($localMap[$k] -ne $remoteMap[$k]) { $diff += $k }
        }
        if ($diff.Count -eq 0) {
            $notify.ShowBalloonTip(3000, 'DSH 升级', '启动脚本与服务器完全一致，无需同步。', 'Info')
            return
        }
        # 4) 方向判定：读双方实际 _meta.json 时间戳（真实内容，非记忆值）
        $lm = Get-Content -LiteralPath (Join-Path $skillDir '_meta.json') -Raw | ConvertFrom-Json
        $rm = Get-Content -LiteralPath (Join-Path $remoteBase '_meta.json') -Raw | ConvertFrom-Json
        $lp = [long]$lm.publishedAt; $rp = [long]$rm.publishedAt
        if ($lp -eq $rp) {
            # 时间戳相同但内容不同：按实际文件修改时间分析并给出建议，弹窗由用户确认方向（上传/拉取/取消）后才执行——绝不自动覆盖服务器良包
            $localNewer = $false; $remoteNewer = $false
            foreach ($k in $diff) {
                $lf = Join-Path $skillDir ($k -replace '/','\')
                $rf = Join-Path $remoteBase ($k -replace '/','\')
                $lt = if (Test-Path -LiteralPath $lf) { (Get-Item -LiteralPath $lf).LastWriteTimeUtc } else { [datetime]::MinValue }
                $rt = if (Test-Path -LiteralPath $rf) { (Get-Item -LiteralPath $rf).LastWriteTimeUtc } else { [datetime]::MinValue }
                if ($lt -gt $rt) { $localNewer = $true } elseif ($rt -gt $lt) { $remoteNewer = $true }
                if ($localNewer -and $remoteNewer) { break }
            }
            $sug = '双向都有更新，无法自动判定，请人工确认合并方向'
            if ($localNewer -and -not $remoteNewer) { $sug = '本机较新（推荐：上传本机版本到服务器）' }
            elseif ($remoteNewer -and -not $localNewer) { $sug = '服务器较新（推荐：拉取服务器版本到本机）' }
            $showFiles = ($diff | Select-Object -First 5) -join '，'
            if ($diff.Count -gt 5) { $showFiles += ' 等' }
            $dlg = "启动脚本：本地与服务器时间戳相同但内容不同（$($diff.Count) 个文件：$showFiles）。`n按实际修改时间分析：$sug。`n`n请选择同步方向（上传前会先备份服务器旧包）："
            $dir = Show-SyncDirectionDialog $dlg
            if ($dir -eq 'upload') {
                # 用户确认上传：备份服务器旧包 + bump _meta 时间戳（等效本地更新），随后走上传分支
                try {
                    $bakZip = Join-Path (Split-Path $skillHubZip -Parent) ("dsh-launcher__skillhub.bak-" + (Get-Date -Format 'yyyyMMdd-HHmmss') + '.zip')
                    Copy-Item -LiteralPath $skillHubZip -Destination $bakZip -Force
                } catch {}
                $lm.publishedAt = [DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds()
                [System.IO.File]::WriteAllText((Join-Path $skillDir '_meta.json'), ($lm | ConvertTo-Json -Depth 5), (New-Object System.Text.UTF8Encoding($false)))
                $lp = [long]$lm.publishedAt
            } elseif ($dir -eq 'pull') {
                # 用户确认拉取：等效服务器时间戳更大，随后走拉取分支
                $rp = $lp + 1
            } else {
                $notify.ShowBalloonTip(3000, 'DSH 升级', '已取消同步，未做任何更改。', 'Info')
                return
            }
        }
        if ($rp -gt $lp) {
            # 兼容性检查：服务器上的启动器声明了兼容的 DSH 版本，本机不满足则提醒先升级 DSH，不更新
            $curDsh = Get-CurrentDshVersion
            if ($rm.compatibleDsh) {
                $compat = @($rm.compatibleDsh)
                if ($curDsh -and ($compat -notcontains $curDsh)) {
                    $notify.ShowBalloonTip(6000, 'DSH 升级', "服务器上的启动器要求 DSH $($compat -join ' / ')，当前为 $curDsh，请先升级 DSH 再同步。", 'Warning')
                    return
                }
            }
            # 服务器新 → 更新本地技能目录
            Get-ChildItem -LiteralPath $remoteBase -Recurse -File | ForEach-Object {
                $dst = Join-Path $skillDir ($_.FullName.Substring($remoteBase.Length + 1))
                New-Item -ItemType Directory -Path (Split-Path $dst -Parent) -Force | Out-Null
                Copy-Item -LiteralPath $_.FullName -Destination $dst -Force
            }
            # 按远端清单清理本地多余文件（远端已删除的本地残留 → 否则哈希永远不一致）
            Get-ChildItem -LiteralPath $skillDir -Recurse -File | ForEach-Object {
                $rel = $_.FullName.Substring($skillDir.Length + 1) -replace '\\','/'
                if (-not $remoteMap.ContainsKey($rel)) {
                    Remove-Item -LiteralPath $_.FullName -Force -ErrorAction SilentlyContinue
                }
            }
            # 重跑 setup 重新生成本机启动器并重打补丁（补丁引擎内部有 compatibleDsh 校验，不兼容补丁会自动跳过）
            & powershell -NoProfile -ExecutionPolicy Bypass -File (Join-Path $skillDir 'assets\setup.ps1') -InstallDir $PSScriptRoot -NoShortcut 2>&1 | Out-Null
            $newTray = Join-Path $PSScriptRoot 'DSH-tray.ps1'
            $okParse = $false
            try { $null = [scriptblock]::Create((Get-Content -LiteralPath $newTray -Raw -Encoding UTF8)); $okParse = $true } catch {}
            if ($okParse) {
                $helper = Join-Path $env:TEMP ("dsh-restart-" + [guid]::NewGuid().ToString('N') + '.ps1')
                # helper 含中文安装路径：必须 UTF8（PS5.1 的 UTF8 即带 BOM），ASCII 会把中文写成 '?'
                @"
Start-Sleep -Seconds 2
Start-Process powershell -ArgumentList '-NoProfile','-ExecutionPolicy','Bypass','-WindowStyle','Hidden','-File','$newTray' -WindowStyle Hidden
"@ | Set-Content -LiteralPath $helper -Encoding UTF8
                # helper 自身也需 Bypass：Restricted 策略机器上 -File 直接跑临时 .ps1 会被拦
                Start-Process powershell -ArgumentList @('-NoProfile','-ExecutionPolicy','Bypass','-WindowStyle','Hidden','-File',$helper) -WindowStyle Hidden
                $notify.ShowBalloonTip(3000, 'DSH 升级', "已从服务器更新启动脚本（$($rm.version)），托盘即将重启。", 'Info')
                [System.Windows.Forms.Application]::Exit()
            } else {
                $notify.ShowBalloonTip(4000, 'DSH 升级', "已从服务器更新启动脚本（$($rm.version)），但新脚本解析失败，请手动重启托盘。", 'Error')
            }
        } elseif ($lp -gt $rp) {
            # 本地新 → 上传到服务器
            & 'C:\Windows\System32\tar.exe' -a -cf $tmpZip -C (Split-Path $skillDir -Parent) 'dsh-launcher'
            if ($LASTEXITCODE -ne 0) { throw "打包失败（exit $LASTEXITCODE）" }
            Copy-Item -LiteralPath $tmpZip -Destination $skillHubZip -Force
            $z = [System.IO.Compression.ZipFile]::OpenRead($skillHubZip); $z.Dispose()
            $h1 = (Get-FileHash -LiteralPath $tmpZip -Algorithm SHA256).Hash
            $h2 = (Get-FileHash -LiteralPath $skillHubZip -Algorithm SHA256).Hash
            if ($h1 -ne $h2) { throw '上传后校验不一致' }
            $notify.ShowBalloonTip(3000, 'DSH 升级', "已将本机启动脚本上传到服务器（$($lm.version)）。", 'Info')
        }
    } catch {
        $notify.ShowBalloonTip(5000, 'DSH 升级', "同步失败：$($_.Exception.Message)", 'Error')
    } finally {
        Remove-Item -LiteralPath $tmpZip -Force -ErrorAction SilentlyContinue
        Remove-Item -LiteralPath $stage -Recurse -Force -ErrorAction SilentlyContinue
    }
}
function Start-DshServer {
    Remove-Item -LiteralPath $logOut, $logErr -Force -ErrorAction SilentlyContinue
    # --no-open 仅 0.1.1-rc.2 及以上支持；老 DSH 传了会"未知参数"启动即退出
    $noOpen = $false
    $curV = Get-CurrentDshVersion
    if ($curV) { $noOpen = -not (Test-NewerVersion $curV '0.1.1-rc.2') }
    if ((Test-Path -LiteralPath $nodeExe) -and (Test-Path -LiteralPath (Join-Path $dsRoot 'apps\cli\lib\bin.js'))) {
        $args = @('apps/cli/lib/bin.js','web')
        if ($noOpen) { $args += '--no-open' }
        return Start-Process -FilePath $nodeExe -ArgumentList $args -WorkingDirectory $dsRoot -WindowStyle Hidden -RedirectStandardOutput $logOut -RedirectStandardError $logErr -PassThru
    }
    if ((Test-Path -LiteralPath $nodeExe) -and (Test-Path -LiteralPath (Join-Path $dsRoot 'apps\cli\src\bin.ts'))) {
        $args = @('--import','tsx/esm','apps/cli/src/bin.ts','web')
        if ($noOpen) { $args += '--no-open' }
        return Start-Process -FilePath $nodeExe -ArgumentList $args -WorkingDirectory $dsRoot -WindowStyle Hidden -RedirectStandardOutput $logOut -RedirectStandardError $logErr -PassThru
    }
    return $null
}
